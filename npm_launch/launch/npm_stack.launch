<launch>
  <arg name="object" default="parallelopiped"/>
  <arg name="gits" default="$(env HOME)/gits/nonprehensile_object_manipulation"/>
  <arg name="npz_path" default="$(find npm_launch)/models/Paralelopiped/Paralelopiped.npz"/>
  <arg name="checkpoint_path"
       default="$(arg gits)/logs/rsl_rl/object_manip_discrete_direct/2026-09-01_00-50-05/model_1100.pt"/>
  <arg name="dry_run" default="false"/>
  <arg name="debug_viz" default="false"/>
  <arg name="executor" default="true"/>
  <arg name="hostname" default="192.168.80.3"/>
  <arg name="executor_interactive" default="false"/>
  <arg name="hand" default="false"/>
  <arg name="use_oracle" default="false"/>
  <arg name="confirm" default="true"/>
  <arg name="confirm_on" default="$(eval arg('confirm') and not arg('hand'))"/>
  <arg name="coord_prefix" default="xterm -e" if="$(arg confirm_on)"/>
  <arg name="coord_prefix" default="" unless="$(arg confirm_on)"/>
  <arg name="policy" default="true"/>
  <arg name="resample_viz" default="true"/>
  <arg name="coordinator" default="true"/>
  <arg name="rviz_config" default="$(eval 'npm.rviz' if arg('hand') else 'npm_robot.rviz')"/>

  <include file="$(find npm_launch)/launch/optitrack_bringup.launch">
    <arg name="spot_bridge" value="$(eval not arg('hand'))"/>
    <arg name="object" value="$(arg object)"/>
  </include>

  <include file="$(find npm_launch)/launch/object_state.launch">
    <arg name="optitrack" value="false"/>
    <arg name="object" value="$(arg object)"/>
    <arg name="npz_path" value="$(arg npz_path)"/>
    <arg name="obs_viz" value="$(eval not arg('policy'))"/>
    <arg name="resample_viz" value="false"/>
  </include>

  <include file="$(find npm_launch)/launch/executor.launch"
           if="$(eval arg('executor') and not arg('hand'))">
    <arg name="npz_path" value="$(arg npz_path)"/>
    <arg name="dry_run" value="$(arg dry_run)"/>
    <arg name="hostname" value="$(arg hostname)"/>
    <arg name="interactive" value="$(arg executor_interactive)"/>
  </include>

  <include file="$(find npm_launch)/launch/hand_push.launch" if="$(arg hand)">
    <arg name="npz_path" value="$(arg npz_path)"/>
  </include>

  <node pkg="npm_policy" type="policy_node.py" name="policy_node" output="screen"
        if="$(arg policy)">
    <rosparam command="load" file="$(find npm_launch)/config/npm.yaml"/>
    <param name="npz_path" value="$(arg npz_path)"/>
    <param name="checkpoint_path" value="$(arg checkpoint_path)"/>
    <param name="use_oracle" value="$(arg use_oracle)"/>
  </node>

  <node pkg="npm_policy" type="pcl_resample_viz_node.py" name="pcl_resample_viz"
        output="screen" if="$(arg resample_viz)">
    <rosparam command="load" file="$(find npm_launch)/config/npm.yaml"/>
    <param name="npz_path" value="$(arg npz_path)"/>
  </node>

  <node pkg="npm_control" type="coordinator_node.py" name="coordinator_node"
        output="screen" if="$(arg coordinator)"
        launch-prefix="$(arg coord_prefix)">
    <rosparam command="load" file="$(find npm_launch)/config/npm.yaml"/>
    <param name="npz_path" value="$(arg npz_path)"/>
    <param name="confirm/settle" type="bool" value="$(arg confirm_on)"/>
    <param name="confirm/pre_push" type="bool" value="$(arg confirm_on)"/>
  </node>

  <group if="$(arg debug_viz)">
    <node pkg="npm_control" type="test_viz_state_markers.py"
          name="test_viz_state_markers" output="screen">
      <rosparam command="load" file="$(find npm_launch)/config/npm.yaml"/>
    </node>
  </group>

  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find npm_launch)/rviz/$(arg rviz_config)"/>
</launch>
